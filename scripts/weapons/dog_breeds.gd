static func get_definition(id: String) -> Dictionary:
	for definition in CATALOG:
		if String(definition["id"]) == id:
			return definition.duplicate(true)
	return {}

static func model_path(id: String) -> String:
	return "res://assets/dogs/%s.glb" % id if not get_definition(id).is_empty() else ""

static func create_stats(rng: RandomNumberGenerator, breed_id: String = "", rarity: int = GunTypes.Rarity.OK) -> GunStats:
	assert(rng != null, "Dog breed generation requires the run's seeded RNG.")
	var definition := get_definition(breed_id)
	if definition.is_empty():
		definition = CATALOG[rng.randi_range(0, CATALOG.size() - 1)]
	var stats := GunStats.new()
	stats.breed_id = String(definition["id"])
	stats.gun_name = String(definition["name"])
	stats.gun_type = rng.randi_range(GunTypes.Type.EXPLOSIVE, GunTypes.Type.ACCELERATING) as GunTypes.Type
	stats.rarity = clampi(rarity, GunTypes.Rarity.POOR, GunTypes.Rarity.PEAK) as GunTypes.Rarity
	stats.base_damage = float(definition["damage"])
	stats.fire_rate = float(definition["fire_rate"])
	stats.projectile_speed = float(definition["projectile_speed"])
	stats.max_ammo = int(definition["max_ammo"])
	stats.reload_seconds = float(definition.get("reload_seconds", -1.0))
	stats.flavor_text = String(definition["flavor_text"])
	stats.description = String(definition["description"])
	return stats
